# Environment variables required by Peachy AI Video Animator

# Video Engine & Google Text:
GEMINI_API_KEY=
API_KEY=
VITE_PEACHY_KEY=

# Optional Text LLMs (Prompt help, errors, and copy assistance only):
OPENAI_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional Selected Provider Overrides (defaults to google-veo and google):
SELECTED_VIDEO_ENGINE=google-veo
SELECTED_TEXT_LLM=google

